NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/veltrix
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:4000
TRUST_PROXY=false
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-unique-local-password
# Optional SMTP for email verification and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VELTRIX <no-reply@example.test>
